#!/usr/bin/env python3
"""Portable test signer for synthetic modules, using real detached CMS."""
import pathlib
import struct
import subprocess
import sys

digest, key, cert, module = sys.argv[1:]
signature = subprocess.check_output([
    "openssl", "cms", "-sign", "-binary", "-noattr", "-nocerts", "-md", digest,
    "-inkey", key, "-signer", cert, "-in", module, "-outform", "DER",
])
with pathlib.Path(module).open("ab") as output:
    output.write(signature)
    output.write(struct.pack(">BBBBB3xI", 0, 0, 2, 0, 0, len(signature)))
    output.write(b"~Module signature appended~\n")
