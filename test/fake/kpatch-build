#!/bin/bash
# 가짜 kpatch-build (테스트용)
# 인자를 해석해서 <-o 디렉터리>/<-n 이름>.ko 파일을 만든다.
# 패치 내용에 FAIL_BUILD 가 있으면 "라이브패치 불가"처럼 실패한다.
set -e
name="" out="." kernel=""
patches=()
while [ $# -gt 0 ]; do
  case "$1" in
    -a) kernel="$2"; shift 2 ;;
    -s) kernel=$(basename "$2"); shift 2 ;;
    -c) kernel=$(basename "$2"); kernel=${kernel#config-}; shift 2 ;;
    -v|-j|-r|-t) shift 2 ;;
    -n) name="$2"; shift 2 ;;
    -o) out="$2"; shift 2 ;;
    *) patches+=("$1"); shift ;;
  esac
done
echo "fake kpatch-build: name=$name patches=${#patches[@]}"
for p in "${patches[@]}"; do
  if grep -q FAIL_BUILD "$p"; then
    echo "ERROR: changed data section (fake)"
    exit 1
  fi
done
mkdir -p "$out"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# 흐름은 가짜지만 ELF 메타데이터 검증은 실제로 거칩니다. 커널에서 로드하지 않습니다.
printf 'static const char info[] __attribute__((used,section(".modinfo"))) = "name=%s\\0vermagic=%s\\0livepatch=Y\\0license=GPL";\n' "$name" "$kernel" > "$tmp/info.c"
cc -c -x c "$tmp/info.c" -o "$out/$name.ko"
{ echo "FAKE-KO $name"; cat "${patches[@]}"; } > "$tmp/patches"
objcopy --add-section ".kpctl_test_patches=$tmp/patches" "$out/$name.ko"
echo "SUCCESS"
