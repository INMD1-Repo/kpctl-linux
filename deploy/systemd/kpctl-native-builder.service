#   ProtectKernelTunables/Modules/Logs=yes, ProtectControlGroups=yes, RestrictSUIDSGID=yes, LockPersonality=yes,
#   RestrictNamespaces=yes, CapabilityBoundingSet=, RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX, UMask=0077,
