[Unit]
Description=kpctl Debian/Rocky native live patch builder (one poll per track)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/kpctl/native-builder/worker.json

[Service]
Type=oneshot
# setup-native-builder.sh 가 --user 값으로 바꿉니다
User=kpbuild
Group=kpbuild
ExecStart=/opt/kpctl/native-builder/kpctl-native-work.sh
TimeoutStartSec=6h
Nice=10
